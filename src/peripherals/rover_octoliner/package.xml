<?xml version="1.0"?>
<package format="3">
  <name>rover_octoliner</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the Amperka Octoliner line sensor module.</description>
  <maintainer email="maintainer@example.com">Rover Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>rover_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-smbus</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

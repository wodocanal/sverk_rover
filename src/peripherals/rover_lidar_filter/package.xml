  <version>0.1.0</version>
  <description>Filters LaserScan returns inside the rover chassis footprint.</description>
  <maintainer email="maintainer@example.com">Rover Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>rclpy</depend>

<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema">
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="camera_width" default="640"/>
  <xacro:arg name="camera_height" default="360"/>
  <xacro:arg name="camera_fps" default="15.0"/>
  <xacro:arg name="lidar_samples" default="720"/>
  <xacro:arg name="lidar_rate_hz" default="10.0"/>
  <xacro:arg name="imu_rate_hz" default="100.0"/>

  <xacro:include filename="$(find rover_description)/urdf/rover.urdf.xacro"/>

  <!-- Spherical collision patches and directed friction approximate 45 degree rollers. -->
  <gazebo reference="front_left_wheel_link">
    <collision>
      <surface><friction><ode>
        <mu>1.0</mu><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
      </ode></friction></surface>
    </collision>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <collision>
      <surface><friction><ode>
        <mu>1.0</mu><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
      </ode></friction></surface>
    </collision>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <collision>
      <surface><friction><ode>
        <mu>1.0</mu><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
      </ode></friction></surface>
    </collision>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <collision>
      <surface><friction><ode>
        <mu>1.0</mu><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
      </ode></friction></surface>
    </collision>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="rplidar_c1_sim" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>$(arg lidar_rate_hz)</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan><horizontal>
          <samples>$(arg lidar_samples)</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159265359</min_angle>
          <max_angle>3.14159265359</max_angle>
        </horizontal></scan>
        <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="yb_mra02_sim" type="imu">
      <always_on>true</always_on>
      <update_rate>$(arg imu_rate_hz)</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="usb_camera_sim" type="camera">
      <always_on>true</always_on>
      <update_rate>$(arg camera_fps)</update_rate>
      <topic>/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="front_camera">
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.03</near><far>30.0</far></clip>
        <camera_info_topic>/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-25</param><param name="max">25</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-25</param><param name="max">25</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-25</param><param name="max">25</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-25</param><param name="max">25</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>

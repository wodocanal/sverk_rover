# Default environment for rover-web.service.
#
# This file is installed to /etc/default/rover-web by deploy/systemd/install.sh.
# rover-web.service also reads /etc/default/rover-bringup first, so ROVER_WS,
# ROS_DOMAIN_ID, and RMW_IMPLEMENTATION normally stay shared with the main
# rover-bringup service.

# Web gateway network settings.
ROVER_WEB_BIND_ADDRESS=0.0.0.0
ROVER_WEB_PORT=8765
ROVER_WEB_COMMAND_TOPIC=/cmd_vel

# UI helpers that can still be linked from the web interface. The rosboard
# process is owned by rover-web by default, so browser-facing processes stay out
# of rover-bringup.
ROVER_WEB_USE_ROSBOARD=true
ROVER_WEB_ROSBOARD_PORT=8888

# Extra launch arguments appended to rover_bringup ui.launch.py.
# Examples:
#   ROVER_WEB_LAUNCH_ARGS="terminal_enabled:=false"
#   ROVER_WEB_LAUNCH_ARGS="web_port:=8080"
ROVER_WEB_LAUNCH_ARGS=

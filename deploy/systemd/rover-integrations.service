[Unit]
Description=SVERK Rover agent and server integrations
After=network-online.target rover-bringup.service
Requires=rover-bringup.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/sverk_rover
EnvironmentFile=-/etc/default/rover-bringup
EnvironmentFile=-/etc/default/rover-integrations
ExecStart=/bin/bash ./deploy/systemd/start-rover-integrations.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target

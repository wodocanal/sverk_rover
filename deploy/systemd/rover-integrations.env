# Integration profile from rover_bringup/config/profiles/integrations.
ROVER_INTEGRATIONS_PROFILE=full

# Extra launch arguments for integrations.launch.py.
# Example: ROVER_INTEGRATIONS_LAUNCH_ARGS="use_agent:=false"
ROVER_INTEGRATIONS_LAUNCH_ARGS=

# Agent model endpoint and credentials. The active agent config names the API
# key variable, while its secret value stays outside Git in this environment.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional MQTT credentials. Leave empty when the broker is anonymous.
FLEET_MQTT_USERNAME=
FLEET_MQTT_PASSWORD=

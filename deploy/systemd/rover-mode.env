# Motion mode managed independently from rover-bringup.
# Allowed values: idle, navigation, mapping, update_map.
ROVER_MODE=navigation
ROVER_MODE_USE_RVIZ=false
ROVER_MODE_START_DELAY=2.0

# Examples:
# ROVER_MODE_LAUNCH_ARGS="map:=/absolute/path/map.yaml"
# ROVER_MODE_LAUNCH_ARGS="slam_params_file:=/absolute/path/slam.yaml"
ROVER_MODE_LAUNCH_ARGS=

[Unit]
Description=SVERK Rover ROS 2 core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/sverk_rover
EnvironmentFile=-/etc/default/rover-bringup
ExecStart=/bin/bash ./deploy/systemd/start-rover-bringup.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target

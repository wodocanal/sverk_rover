[Unit]
Description=SVERK Rover Web UI
After=network-online.target rover-bringup.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/sverk_rover
EnvironmentFile=-/etc/default/rover-bringup
EnvironmentFile=-/etc/default/rover-web
ExecStart=/bin/bash ./deploy/systemd/start-rover-web.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target

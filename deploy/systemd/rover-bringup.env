# Default environment for rover-bringup.service.
#
# This file is installed to /etc/default/rover-bringup by
# deploy/systemd/install.sh. Edit the installed copy on the rover, then run:
#
#   sudo systemctl restart rover-bringup

# ROS workspace that contains install/setup.bash.
ROVER_WS=/home/pi/sverk_rover

# Core preset from rover_bringup/config/profiles/core.
ROVER_CORE_PROFILE=full
# Backward-compatible alias read when ROVER_CORE_PROFILE is absent.
ROVER_PROFILE=full

# Serial device discovery mode: configured, verify, or full.
ROVER_DISCOVERY_MODE=configured

# rover-bringup owns only hardware, odometry, localization and twist_mux.
# UI, navigation/mapping and integrations are separate services.

# Optional ROS settings.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Extra launch arguments appended to core.launch.py.
# Examples:
#   ROVER_LAUNCH_ARGS="use_camera:=false use_led_strip:=false"
# Agent/UI/mode flags in this legacy list are ignored by rover-bringup.
ROVER_LAUNCH_ARGS=

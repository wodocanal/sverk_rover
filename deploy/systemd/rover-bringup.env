# Default environment for rover-bringup.service.
#
# This file is installed to /etc/default/rover-bringup by
# deploy/systemd/install.sh. Edit the installed copy on the rover, then run:
#
#   sudo systemctl restart rover-bringup

# ROS workspace that contains install/setup.bash.
ROVER_WS=/home/pi/sverk_rover

# Main launch preset from rover_bringup/config/profiles.
ROVER_PROFILE=full

# Serial device discovery mode: configured, verify, or full.
ROVER_DISCOVERY_MODE=configured

# rover-bringup intentionally excludes browser-facing tools. Use
# rover-web.service for the web gateway, web terminal, and rosboard.
ROVER_BRINGUP_USE_WEB=false
ROVER_BRINGUP_USE_ROSBOARD=false

# Optional ROS settings.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Extra launch arguments appended to robot.launch.py.
# Examples:
#   ROVER_LAUNCH_ARGS="use_camera:=false use_agent:=false"
#   ROVER_LAUNCH_ARGS="profile:=navigation use_rviz:=false"
# Do not enable use_web/use_rosboard here; manage browser-facing tools with
# rover-web.service.
ROVER_LAUNCH_ARGS=

# Agent / fleet bridge credentials and model settings.
# Keep secrets in the installed /etc/default/rover-bringup file, not in git.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
FLEET_MQTT_USERNAME=
FLEET_MQTT_PASSWORD=
